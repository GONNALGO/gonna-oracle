# GONNA ARENA oracle server — example env. Copy to .env for LOCAL dev only.
# NEVER commit a real mnemonic. In production ORACLE_MNEMONIC_FILE points at a
# mounted secret (0600), outside the repo.

ARENA_NETWORK=testnet
ARENA_APP_ID=769907387
GONNA_ASA_ID=769688287
TREASURY_ADDR=4OQ3LJ3JW67JEY55TMHLGZG3MWWLTVFZERGY67LBJEJLOGEUUX2PYHQGGM

ALGOD_URL=https://testnet-api.algonode.cloud
INDEXER_URL=https://testnet-idx.algonode.cloud

# path to a 0600 file containing ONLY the 25-word oracle mnemonic (PREFERRED)
ORACLE_MNEMONIC_FILE=/run/secrets/oracle_mnemonic
# FALLBACK (used only when ORACLE_MNEMONIC_FILE is unset): the 25-word
# mnemonic inline — for platforms where secret env vars are API-automatable
# but secret files are not (e.g. Render). Never logged. Keep it out of repos.
# ORACLE_MNEMONIC="word1 word2 ... word25"

PORT=8787
# exact allow-list, comma separated
CORS_ORIGIN=https://gonna.bond

# fixed 60s windows: "<per-IP>" or "<per-IP>,<per-addr>" (default 30,6)
MAX_SIG_PER_MIN=30,6

# optional; defaults: {"full":2000000,"stage":[500000 x7]}
# SCORE_CAPS_JSON={"full":2000000,"stage":[500000,500000,500000,500000,500000,500000,500000]}

# SQLite file (WAL). Must be on a real fs (Docker volume /data).
DB_PATH=/data/oracle.db

# --- M2 replay verification (SPEC-m2 §5) ---
# 1 = sign ONLY after bit-exact replay of the v2 input log (default).
# 0 = recovery mode: M1 structural checks only (see RUNBOOK).
REPLAY_ENFORCE=1
# accept legacy v1 logs (recorded incl. the intro; NOT replayable) without
# replay: default 1 on testnet, 0 on mainnet.
# 0 = REFUSE legacy GIL v1 logs (400 LEGACY LOG REFUSED) — required everywhere,
# testnet included: with 1 the v1 branch bypasses the full replay and signs
# arbitrary scores (SEV-1, found by Wave B dogfood 2026-08-26). Live Render
# service runs ALLOW_LEGACY_GIL=0 since that date.
ALLOW_LEGACY_GIL=0
# pinned engine bundles directory (default: <pkg>/replay-bundles)
# REPLAY_BUNDLES_DIR=/data/replay-bundles
# wall-clock budget per replay, ms (default 30000; abort -> 500 REPLAY TIMEOUT - RETRY)
# REPLAY_TIMEOUT_MS=30000

# --- M-1 mainnet hardening ---------------------------------------------------
# canonical network selector (wins over the legacy ARENA_NETWORK name)
NETWORK=testnet
# CORS allow-list (wins over legacy CORS_ORIGIN). Defaults: testnet serves
# https://gonna.bond only; mainnet serves https://gonna.bond +
# https://www.gonna.bond and NEVER localhost.
#ALLOWED_ORIGINS=https://gonna.bond,https://www.gonna.bond
# SEV-2b durable receipts (Turso free tier, @libsql/client). UNSET -> local
# SQLite (ephemeral on free-tier hosts: boot warns; reconciliation scan at
# boot compares on-chain continue payments vs DB receipts). A configured but
# unreachable Turso is FATAL at boot (never silently fall back to ephemeral).
#TURSO_URL=libsql://<db>-<org>.turso.io
#TURSO_AUTH_TOKEN=
